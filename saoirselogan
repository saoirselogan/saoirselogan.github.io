</head>

<body>

    <!-- NAVIGATION -->
    <nav>
        <div class="nav-container">
            <a href="#home" class="logo">Saoirse Logan</a>

            <ul class="nav-links">
                <li><a href="#about">About</a></li>
                <li><a href="#education">Education</a></li>
                <li><a href="#experience">Experience</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>

            <button class="menu-button" aria-label="Open navigation">
                ☰
            </button>
        </div>
    </nav>


    <main>

        <!-- HOME / HERO -->
        <section id="home" class="hero">
            <div class="container hero-content">

                <p class="intro">Hello, I'm</p>

                <h1>Saoirse Logan</h1>

                <h2>Communication & Marketing Student</h2>

                <p class="hero-description">
                    I am a student at Fairfield University studying
                    Communication with a minor in Marketing. I am interested
                    in communication, marketing, social media, and creating
                    meaningful connections between brands and their audiences.
                </p>

                <div class="hero-buttons">
                    <a href="#experience" class="button">
                        View My Experience
                    </a>

                    <a href="#contact" class="button button-outline">
                        Contact Me
                    </a>
                </div>

            </div>
        </section>


        <!-- ABOUT -->
        <section id="about">
            <div class="container">

                <p class="section-label">ABOUT</p>
                <h2 class="section-title">About Me</h2>

                <div class="about-text">

                    <p>
                        I am currently pursuing a Bachelor of Arts at
                        Fairfield University, majoring in Communication
                        and minoring in Marketing.
                    </p>

                    <p>
                        Through my coursework and professional experience,
                        I have developed skills in communication, customer
                        service, teamwork, social media, and marketing.
                        I am interested in continuing to develop these
                        skills through new professional opportunities.
                    </p>

                    <p>
                        My coursework includes Fashion Marketing,
                        Interpersonal Communication Theories, Public
                        Speaking, Media Institutions, and Small Group
                        Communication.
                    </p>

                </div>

            </div>
        </section>


        <!-- EDUCATION -->
        <section id="education" class="alternate-section">
            <div class="container">

                <p class="section-label">EDUCATION</p>
                <h2 class="section-title">Education</h2>

                <div class="education-card">

                    <div>
                        <h3>Fairfield University</h3>
                        <p class="location">Fairfield, Connecticut</p>
                    </div>

                    <div class="education-details">
                        <p><strong>Bachelor of Arts</strong></p>
                        <p>Major: Communication</p>
                        <p>Minor: Marketing</p>
                        <p>Expected Graduation: May 2027</p>
                        <p>GPA: 3.22</p>
                    </div>

                </div>

                <div class="organizations">
                    <h3>Clubs & Organizations</h3>
                    <p>Communication Club • Marketing Club</p>
                </div>

            </div>
        </section>


        <!-- EXPERIENCE -->
        <section id="experience">
            <div class="container">

                <p class="section-label">EXPERIENCE</p>
                <h2 class="section-title">Professional Experience</h2>


                <div class="experience-item">

                    <div class="experience-date">
                        Sep. 2025 – May 2026
                    </div>

                    <div class="experience-content">
                        <h3>Building Staff</h3>
                        <h4>
                            Fairfield University Recreation Complex
                        </h4>

                        <ul>
                            <li>
                                Deliver high-quality customer service to
                                RecPlex patrons and help create a welcoming
                                environment.
                            </li>

                            <li>
                                Greet and assist patrons while providing
                                information and support as needed.
                            </li>

                            <li>
                                Help maintain a clean, safe, and smoothly
                                functioning facility.
                            </li>

                            <li>
                                Distribute recreational equipment and help
                                ensure its proper use and return.
                            </li>
                        </ul>
                    </div>

                </div>


                <div class="experience-item">

                    <div class="experience-date">
                        June 2024 – Present
                    </div>

                    <div class="experience-content">
                        <h3>Camp Counselor</h3>
                        <h4>Bethlehem Early Learning Center</h4>

                        <ul>
                            <li>
                                Facilitate daily activities for
                                preschool-aged campers.
                            </li>

                            <li>
                                Help plan and organize new activities for
                                children each day.
                            </li>

                            <li>
                                Follow safety protocols during indoor and
                                outdoor activities.
                            </li>

                            <li>
                                Help children develop their social and
                                educational abilities.
                            </li>
                        </ul>
                    </div>

                </div>


                <div class="experience-item">

                    <div class="experience-date">
                        May 2024 – Aug. 2024
                    </div>

                    <div class="experience-content">
                        <h3>Food Runner</h3>
                        <h4>Glen Rock Inn</h4>

                        <ul>
                            <li>
                                Delivered food and beverages to guests
                                while providing quality service.
                            </li>

                            <li>
                                Collaborated with kitchen and waitstaff
                                to keep food delivery running smoothly.
                            </li>
                        </ul>
                    </div>

                </div>


                <div class="experience-item">

                    <div class="experience-date">
                        Dec. 2022 – Dec. 2023
                    </div>

                    <div class="experience-content">
                        <h3>Retail Sales Worker</h3>
                        <h4>Hot Jewelry Box</h4>

                        <ul>
                            <li>
                                Assisted customers with product selection
                                and questions.
                            </li>

                            <li>
                                Organized displays and inventory.
                            </li>

                            <li>
                                Collaborated with coworkers to manage
                                and replenish merchandise.
                            </li>

                            <li>
                                Managed customer returns, exchanges,
                                and register transactions.
                            </li>
                        </ul>
                    </div>

                </div>

            </div>
        </section>


        <!-- PROJECTS -->
        <section id="projects" class="alternate-section">
            <div class="container">

                <p class="section-label">PROJECTS</p>
                <h2 class="section-title">Selected Projects</h2>

                <div class="project-grid">

                    <article class="project-card">

                        <p class="project-semester">
                            Spring 2024
                        </p>

                        <h3>
                            Social Media & Romantic Relationships
                        </h3>

                        <h4>
                            Interpersonal Communication Theories
                        </h4>

                        <p>
                            Researched how social media plays a role in
                            romantic relationships and shapes narratives
                            surrounding trust and mistrust.
                        </p>

                        <p>
                            Collaborated with a group of four students
                            to develop a research thesis examining how
                            attachment styles contribute to the influence
                            of social media on relationships.
                        </p>

                    </article>


                    <article class="project-card">

                        <p class="project-semester">
                            Fall 2025
                        </p>

                        <h3>
                            Generation Z Marketing Strategy
                        </h3>

                        <h4>
                            Fashion Marketing
                        </h4>

                        <p>
                            Collaborated with a small business to improve
                            its marketing strategy and attract Generation
                            Z as potential clientele.
                        </p>

                        <p>
                            Conducted a social media analysis of the
                            company's accounts and successful posts from
                            larger brands to recommend new strategies.
                        </p>

                    </article>

                </div>

            </div>
        </section>


        <!-- SKILLS -->
        <section id="skills">
            <div class="container">

                <p class="section-label">SKILLS</p>
                <h2 class="section-title">Skills & Tools</h2>

                <div class="skills-container">

                    <span>Microsoft Word</span>
                    <span>Microsoft Excel</span>
                    <span>PowerPoint</span>
                    <span>Outlook</span>
                    <span>Google Workspace</span>
                    <span>Canva</span>
                    <span>iMovie</span>
                    <span>Instagram</span>
                    <span>TikTok</span>
                    <span>Pinterest</span>
                    <span>LinkedIn</span>
                    <span>Social Media</span>

                </div>

            </div>
        </section>


        <!-- CONTACT -->
        <section id="contact" class="contact-section">
            <div class="container contact-content">

                <p class="section-label">CONTACT</p>

                <h2>Let's Connect</h2>

                <p>
                    I'm always interested in connecting and learning
                    about new opportunities in communication and marketing.
                </p>

                <div class="contact-links">

                    <a href="mailto:saoirse.logan@student.fairfield.edu">
                        Email Me
                    </a>

                    <a
                        href="https://www.linkedin.com/in/saoirselogan"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        LinkedIn
                    </a>

                </div>

            </div>
        </section>

    </main>


    <!-- FOOTER -->
    <footer>
        <p>
            © <span id="year"></span> Saoirse Logan
        </p>
    </footer>


