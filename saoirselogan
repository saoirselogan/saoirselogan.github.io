/* ================================
   GENERAL
================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 75px;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: #222222;
    background: #ffffff;
    line-height: 1.7;
}

.container {
    width: 90%;
    max-width: 1050px;
    margin: 0 auto;
}

section {
    padding: 90px 0;
}

.alternate-section {
    background: #f7f7f5;
}

.section-label {
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
    color: #777;
    margin-bottom: 8px;
}

.section-title {
    font-size: 36px;
    margin-bottom: 45px;
    letter-spacing: -1px;
}


/* ================================
   NAVIGATION
================================ */

nav {
    position: fixed;
    width: 100%;
    top: 0;
    left: 0;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid #eeeeee;
    z-index: 1000;
}

.nav-container {
    max-width: 1050px;
    width: 90%;
    height: 70px;
    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    color: #222;
    text-decoration: none;
    font-size: 18px;
    font-weight: bold;
}

.nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
}

.nav-links a {
    text-decoration: none;
    color: #555;
    font-size: 14px;
    transition: 0.2s ease;
}

.nav-links a:hover,
.nav-links a.active {
    color: #000;
}

.menu-button {
    display: none;
    border: none;
    background: transparent;
    font-size: 25px;
    cursor: pointer;
}


/* ================================
   HERO
================================ */

.hero {
    min-height: 100vh;
    padding-top: 70px;

    display: flex;
    align-items: center;
}

.hero-content {
    max-width: 1050px;
}

.intro {
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 2px;
    color: #777;
    margin-bottom: 5px;
}

.hero h1 {
    font-size: clamp(55px, 9vw, 90px);
    line-height: 1.05;
    letter-spacing: -4px;
    margin-bottom: 12px;
}

.hero h2 {
    font-size: 25px;
    color: #666;
    font-weight: 400;
    margin-bottom: 25px;
}

.hero-description {
    max-width: 670px;
    color: #555;
    font-size: 18px;
    margin-bottom: 32px;
}

.hero-buttons {
    display: flex;
    gap: 12px;
}

.button {
    display: inline-block;
    padding: 12px 22px;
    background: #222;
    color: #fff;
    text-decoration: none;
    border: 1px solid #222;
    border-radius: 3px;
    transition: all 0.2s ease;
}

.button:hover {
    background: #555;
    border-color: #555;
}

.button-outline {
    background: transparent;
    color: #222;
}

.button-outline:hover {
    color: #fff;
}


/* ================================
   ABOUT
================================ */

.about-text {
    max-width: 760px;
    color: #555;
    font-size: 17px;
}

.about-text p {
    margin-bottom: 20px;
}


/* ================================
   EDUCATION
================================ */

.education-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;

    padding-bottom: 30px;
    border-bottom: 1px solid #ddd;
}

.education-card h3 {
    font-size: 24px;
}

.location {
    color: #777;
}

.education-details p {
    color: #555;
    margin-bottom: 3px;
}

.organizations {
    margin-top: 30px;
}

.organizations h3 {
    margin-bottom: 5px;
}

.organizations p {
    color: #666;
}


/* ================================
   EXPERIENCE
================================ */

.experience-item {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 40px;

    padding: 35px 0;
    border-top: 1px solid #ddd;
}

.experience-item:last-child {
    border-bottom: 1px solid #ddd;
}

.experience-date {
    color: #777;
    font-size: 14px;
}

.experience-content h3 {
    font-size: 22px;
}

.experience-content h4 {
    color: #666;
    font-size: 16px;
    font-weight: normal;
    margin-bottom: 15px;
}

.experience-content ul {
    padding-left: 20px;
    color: #555;
}

.experience-content li {
    margin-bottom: 6px;
}


/* ================================
   PROJECTS
================================ */

.project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.project-card {
    background: #fff;
    padding: 35px;
    border: 1px solid #ddd;
    border-radius: 4px;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.project-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
}

.project-semester {
    color: #888;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
}

.project-card h3 {
    font-size: 22px;
    margin-bottom: 3px;
}

.project-card h4 {
    font-size: 14px;
    font-weight: normal;
    color: #777;
    margin-bottom: 20px;
}

.project-card p {
    color: #555;
    margin-bottom: 15px;
}


/* ================================
   SKILLS
================================ */

.skills-container {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.skills-container span {
    background: #f3f3f3;
    padding: 9px 16px;
    border-radius: 20px;
    font-size: 14px;

    transition: 0.2s ease;
}

.skills-container span:hover {
    background: #222;
    color: white;
}


/* ================================
   CONTACT
================================ */

.contact-section {
    background: #222;
    color: #fff;
}

.contact-content {
    text-align: center;
    max-width: 700px;
}

.contact-section .section-label {
    color: #aaa;
}

.contact-content h2 {
    font-size: 44px;
    margin-bottom: 15px;
}

.contact-content > p {
    color: #ccc;
    margin-bottom: 30px;
}

.contact-links {
    display: flex;
    justify-content: center;
    gap: 15px;
}

.contact-links a {
    text-decoration: none;
    color: #222;
    background: #fff;
    padding: 12px 25px;
    border-radius: 3px;

    transition: 0.2s ease;
}

.contact-links a:hover {
    background: #ddd;
}


/* ================================
   FOOTER
================================ */

footer {
    text-align: center;
    padding: 25px;
    color: #888;
    font-size: 13px;
    background: #fff;
}


/* ================================
   MOBILE
================================ */

@media (max-width: 750px) {

    section {
        padding: 65px 0;
    }

    .nav-links {
        display: none;

        position: absolute;
        top: 70px;
        left: 0;

        width: 100%;
        padding: 25px;

        background: #fff;
        border-bottom: 1px solid #ddd;

        flex-direction: column;
        text-align: center;
    }

    .nav-links.open {
        display: flex;
    }

    .menu-button {
        display: block;
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .hero h2 {
        font-size: 21px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: flex-start;
    }

    .education-card {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .experience-item {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .project-grid {
        grid-template-columns: 1fr;
    }

    .contact-links {
        flex-direction: column;
        align-items: center;
    }
