.contact-content h2 {
    font-size: 44px;
    margin-bottom: 15px;
}

.contact-content > p {
    color: #ccc;
    margin-bottom: 30px;
}

.contact-links {
    display: flex;
    justify-content: center;
    gap: 15px;
}

.contact-links a {
    text-decoration: none;
    color: #222;
    background: #fff;
    padding: 12px 25px;
    border-radius: 3px;

    transition: 0.2s ease;
}

.contact-links a:hover {
    background: #ddd;
}


/* ================================
   FOOTER
================================ */

footer {
    text-align: center;
    padding: 25px;
    color: #888;
    font-size: 13px;
    background: #fff;
}


/* ================================
   MOBILE
================================ */

@media (max-width: 750px) {

    section {
        padding: 65px 0;
    }

    .nav-links {
        display: none;

        position: absolute;
        top: 70px;
        left: 0;

        width: 100%;
        padding: 25px;

        background: #fff;
        border-bottom: 1px solid #ddd;

        flex-direction: column;
        text-align: center;
    }

    .nav-links.open {
        display: flex;
    }

    .menu-button {
        display: block;
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .hero h2 {
        font-size: 21px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: flex-start;
    }

    .education-card {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .experience-item {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .project-grid {
        grid-template-columns: 1fr;
    }

    .contact-links {
        flex-direction: column;
        align-items: center;
    }
}
